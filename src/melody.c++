int main()
{
    HMIDIOUT hMidi;

    MMRESULT result = midiOutOpen(&hMidi, MIDI_MAPPER, 0, 0, CALLBACK_NULL);

    if (result != MMSYSERR_NOERROR)
    {
        std::cerr << "Failed to open MIDI output device!\n";
        return 1;
    }

    // General MIDI 81 = Lead 2 (Sawtooth).
    // Change to 80 for Lead 1 (Square) if your device supports it.
    int instrument = 80;
    DWORD programChange = 0xC0 | (instrument << 8);
    midiOutShortMsg(hMidi, programChange);

    std::cout << "Playing U.N. Owen Was Her - single note version\n";
    std::cout << "BPM: " << BPM << "\n";
    std::cout << "Notes: " << song.size() << "\n";

    for (const Note &note : song)
        playMidiNote(hMidi, note);

    midiOutReset(hMidi);
    midiOutClose(hMidi);

    std::cout << "Finished!\n";
    return 0;
}
