#include <windows.h>
#include <mmsystem.h>
#include <iostream>
#include <vector>
#include <algorithm>

#pragma comment(lib, "winmm.lib")

struct Note
{
    int midi;
    int ticks;
};

// Extracted from the uploaded MIDI's 8-Bit Square track.
// Reduced to ONE note at a time by keeping the highest active note.
constexpr int TICKS_PER_BEAT = 384;
constexpr double BPM = 155.0; // Change this to slow down/speed up
constexpr double MS_PER_BEAT = 60000.0 / BPM;
constexpr double MS_PER_TICK = MS_PER_BEAT / TICKS_PER_BEAT;

void playMidiNote(HMIDIOUT hMidi, const Note &note)
{
    int duration = static_cast<int>(note.ticks * MS_PER_TICK);

    if (note.midi < 0)
    {
        Sleep(duration);
        return;
    }

    int midiNote = std::clamp(note.midi, 0, 127);
    int velocity = 100;

    DWORD noteOn = 0x90 | (midiNote << 8) | (velocity << 16);
    midiOutShortMsg(hMidi, noteOn);

    Sleep(std::max(1, duration));

    DWORD noteOff = 0x80 | (midiNote << 8);
    midiOutShortMsg(hMidi, noteOff);
}

